{
  "name": "exilequesting",
  "version": "0.1.1",
  "description": "A modern, build-aware Path of Exile campaign companion.",
  "main": "dist-electron/main.cjs",
  "author": "Stoffe101",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 npm run dev:electron\"",
    "dev:electron": "npm run build:electron && electron .",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --packages=external --out-extension:.js=.cjs --outdir=dist-electron",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stress": "vitest run src/core/stress.test.ts",
    "audit:campaign": "node tools/audit-campaign.mjs",
    "lint:campaign": "esbuild tools/lint-campaign.ts --bundle --platform=node --format=esm --outfile=.tmp/lint-campaign.mjs && node .tmp/lint-campaign.mjs",
    "simulate:campaign": "esbuild tools/simulate-campaign.ts --bundle --platform=node --format=esm --outfile=.tmp/simulate-campaign.mjs && node .tmp/simulate-campaign.mjs",
    "verify:preplaytest": "npm run typecheck && npm test && npm run audit:campaign && npm run lint:campaign && npm run simulate:campaign",
    "check:upstream": "node tools/check-upstream.mjs",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --dir",
    "import:upstream": "node tools/import-exile-ui.mjs"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "dev.stoffe.exilequesting",
    "productName": "ExileQuesting",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/campaign",
        "to": "campaign"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "ExileQuesting-${version}-setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
